{
  "product": "<product-name>",
  "created": "<YYYY-MM-DD>",
  "pipeline_version": 2,
  "mode": "greenfield",
  "current_stage": "1-intake",
  "stack": null,
  "budget": {
    "max_steps": 200,
    "used_steps": 0,
    "note": "When the cap is hit: save, stop gracefully, resume later (see CLAUDE.md section 7)"
  },
  "activity": {
    "log": "activity-log.md",
    "last_entry": null
  },
  "gates_policy": {
    "human_required": ["release-preview"],
    "note": "The only mandatory human gate is the release preview; everything else is automatic and pauses only when a safety condition fires"
  },
  "stages": {
    "0-bootstrap":    { "status": "done",    "gate": "auto",  "gate_passed": true,  "outputs": ["PROJECT.md", "sdd-state.json"] },
    "1-intake":       { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "intake",               "outputs": ["discovery.md"] },
    "2-bdd":          { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "gherkin-author",       "outputs": ["features/*.feature"] },
    "3-requirements": { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "requirements-engineer","outputs": ["requirements.md"] },
    "4-spec":         { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "spec-architect",       "outputs": ["spec/*.md"] },
    "5-architecture": { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "stack-advisor",        "outputs": ["architecture.md"] },
    "6-implement":    { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "implementer+qa-test",  "outputs": ["src/", "tests/"] },
    "7-review":       { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "code-reviewer+security-reviewer", "outputs": ["review-report.md"] },
    "8-evaluation":   { "status": "pending", "gate": "auto",  "gate_passed": false, "agent": "evaluator",            "outputs": ["evaluation-report.md"] },
    "9-release":      { "status": "pending", "gate": "human", "gate_passed": false, "agent": "release-manager",      "outputs": ["release-notes.md", "CHANGELOG.md"], "human_gate": "release-preview" }
  },
  "traceability": {
    "note": "Maintain FR/NFR <-> scenario <-> SPEC <-> TEST; impact analysis in change mode depends on it"
  },
  "change_requests": []
}
